{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Flins",
  "version": "0.2.1",
  "identifier": "com.maksimfedorov.flins",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flins",
        "width": 1150,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: blob:; font-src 'self' asset: data:; connect-src 'self' ipc: http://localhost:* http://127.0.0.1:* http://[::1]:* http://*.local:* http://192.168.*.*:* http://10.*.*.*:* http://172.16.*.*:* http://172.17.*.*:* http://172.18.*.*:* http://172.19.*.*:* http://172.2*.*.*:* http://172.30.*.*:* http://172.31.*.*:* http://100.*.*.*:* https://*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3NzcyREMxMjExN0Y1MUMKUldRYzlSY2h3UzEzOTE2Nm9saUNTQ0VTU2J5R0NoMTVnb3gvUEpPSUZ6TGFidW52UFd4ZkM3bGwK",
      "endpoints": [
        "https://github.com/dreamyrt/flins/releases/latest/download/latest.json"
      ]
    }
  }
}
